{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "echo lint",
        "headers": {
          "Authorization": "Bearer $HOOK_TOKEN"
        }
      },
      {
        "type": "http",
        "url": "https://hooks.example.com/notify",
        "async": true
      },
      {
        "type": "prompt",
        "prompt": "Review: $ARGUMENTS",
        "headers": {
          "Authorization": "Bearer $HOOK_TOKEN"
        }
      },
      {
        "type": "agent",
        "prompt": "Delegate: $ARGUMENTS",
        "shell": "bash"
      }
    ]
  }
}
