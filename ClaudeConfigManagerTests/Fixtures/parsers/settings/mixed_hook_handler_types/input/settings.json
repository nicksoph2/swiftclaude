{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "echo preparing",
        "timeout": 6,
        "statusMessage": "Running command hook"
      },
      {
        "type": "http",
        "url": "https://hooks.example.com/pre",
        "timeout": 12
      },
      {
        "type": "prompt",
        "prompt": "Inspect the hook payload: $ARGUMENTS",
        "statusMessage": "Prompting reviewer"
      },
      {
        "type": "agent",
        "prompt": "Delegate this hook check: $ARGUMENTS"
      }
    ]
  }
}
