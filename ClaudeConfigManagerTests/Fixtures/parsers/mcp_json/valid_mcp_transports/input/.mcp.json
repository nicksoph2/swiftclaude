{
  "github": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github"],
    "env": {
      "GITHUB_TOKEN": "..."
    },
    "cwd": "/tmp/project"
  },
  "remote-api": {
    "url": "https://api.example.com/mcp",
    "headers": {
      "Authorization": "Bearer token"
    }
  },
  "legacy-sse": {
    "url": "https://old.example.com/sse",
    "transport": "sse"
  }
}
